{
	"name": "virgo-api",
	"version": "2.19.7",
	"description": "virgoOS API",
	"author": "univrs",
	"license": "UNLICENSED",
	"main": "index.js",
	"scripts": {
		"deb": "node-deb --no-default-package-dependencies --no-rebuild --install-strategy copy ${DEB_ARCH:+--architecture $DEB_ARCH} -- index.js config.js cli/ cert/ src/ indexer/ systemd/",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"bin": {
		"virgo": "./cli/virgo"
	},
	"node_deb": {
		"executable_name": "virgo",
		"architecture": "arm64",
		"init": "systemd",
		"install_dir": "/var/www",
		"dependencies": "apt-show-versions,smartmontools,nvme-cli,jq,msmtp-mta,bsd-mailx,redis-server,iputils-arping,network-manager,avahi-daemon,avahi-utils",
		"user": "root",
		"templates": {
			"preinst": "templates/preinstall",
			"postinst": "templates/postinstall",
			"systemd_service": "templates/systemd.service"
		},
		"entrypoints": {
			"daemon": "index.js",
			"cli": "cli/virgo"
		}
	},
	"engines": {
		"node": ">=24.13.0",
		"npm": ">=11.6.2"
	},
	"type": "module",
	"cpu": [
		"arm64",
		"x64"
	],
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"bullmq": "^6.3.8",
		"camelcase-keys": "^10.0.3",
		"change-case": "^5.4.4",
		"chokidar": "^5.0.0",
		"commander": "^15.0.0",
		"compromise": "^14.17.0",
		"docker-compose": "^1.5.0",
		"dockerode": "^5.0.1",
		"dotenv": "^18.0.3",
		"execa": "^10.0.1",
		"compression": "^1.8.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"express-validator": "^7.3.2",
		"ini": "^7.0.0",
		"ioredis": "^6.0.0",
		"js-yaml": "^5.4.2",
		"kelvin-to-celsius": "^1.1.0",
		"linux-sys-user": "^2.0.2",
		"node-datachannel": "^0.33.4",
		"path": "^0.12.7",
		"plist": "^5.0.0",
		"pretty-bytes": "^7.1.3",
		"pretty-ms": "^9.3.1",
		"sequelize": "^6.37.8",
		"socket.io": "^4.8.3",
		"socket.io-client": "^4.8.3",
		"sqlite3": "^6.0.1",
		"systeminformation": "^5.33.13",
		"touch": "^3.1.1"
	},
	"optionalDependencies": {
		"bufferutil": "*",
		"utf-8-validate": "*"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"node-deb": "^0.10.7"
	},
	"overrides": {
		"glob": "^13.0.0",
		"node-gyp": "^12.1.0",
		"validator": "^13.15.23"
	},
	"allowScripts": {
		"bufferutil@4.1.0": true,
		"cpu-features@0.0.10": true,
		"msgpackr-extract@3.0.4": true,
		"protobufjs@7.6.6": true,
		"sqlite3@6.0.1": true,
		"ssh2@1.17.0": true,
		"utf-8-validate@6.0.6": true
	}
}
