{
	"name": "virgo-api",
	"version": "2.23.14",
	"description": "virgoOS API",
	"author": "univrs",
	"license": "UNLICENSED",
	"main": "index.js",
	"scripts": {
		"changelog": "bash scripts/changelog.sh",
		"deb": "npm run changelog && node-deb --no-default-package-dependencies --no-rebuild --install-strategy copy ${DEB_ARCH:+--architecture $DEB_ARCH} -- index.js config.js cli/ cert/ src/ indexer/ systemd/",
		"sync": "sh -c 'host=${1:?usage: npm run sync -- <host>}; paths=\"index.js config.js cli cert src indexer systemd\"; files=$({ git diff --name-only --diff-filter=d HEAD -- $paths; git ls-files --others --exclude-standard -- $paths; } | sort -u); if [ -z \"$files\" ]; then echo \"No changed files\"; exit 0; fi; printf \"%s\\n\" \"$files\"; printf \"%s\\n\" \"$files\" | rsync -rltp --files-from=- --rsync-path=\"sudo rsync\" ./ \"voyager@$host:/var/www/virgo-api/app/\" && ssh \"voyager@$host\" sudo systemctl restart virgo-api' sync",
		"test": "node --test test/*.test.js",
		"test:indexer": "node --test test/indexer-*.test.js"
	},
	"bin": {
		"virgo": "./cli/virgo"
	},
	"node_deb": {
		"executable_name": "virgo",
		"init": "systemd",
		"install_dir": "/var/www",
		"extra_files": "deb-extra",
		"dependencies": "apt-show-versions,smartmontools,nvme-cli,jq,msmtp-mta,bsd-mailx,redis-server,iputils-arping,network-manager,avahi-daemon,avahi-utils,zip",
		"user": "root",
		"templates": {
			"preinst": "templates/preinstall",
			"postinst": "templates/postinstall",
			"systemd_service": "templates/systemd.service"
		},
		"entrypoints": {
			"daemon": "index.js",
			"cli": "cli/virgo"
		}
	},
	"engines": {
		"node": ">=24.22.3",
		"npm": ">=11.19.1"
	},
	"type": "module",
	"cpu": [
		"arm64",
		"x64"
	],
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"bullmq": "^6.7.3",
		"camelcase-keys": "^10.0.3",
		"change-case": "^5.4.4",
		"chokidar": "^6.0.0",
		"commander": "^15.1.0",
		"compression": "^1.8.2",
		"compromise": "^14.20.0",
		"cron-parser": "^5.10.4",
		"docker-compose": "^1.5.0",
		"dockerode": "^5.0.1",
		"dotenv": "^18.0.10",
		"execa": "^10.2.1",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.4",
		"express-validator": "^7.3.2",
		"ini": "^7.0.0",
		"ioredis": "^6.0.0",
		"js-yaml": "^5.5.0",
		"kelvin-to-celsius": "^1.1.0",
		"linux-sys-user": "^2.0.2",
		"node-datachannel": "^0.33.6",
		"path": "^0.12.7",
		"plist": "^5.1.1",
		"pretty-bytes": "^7.2.0",
		"pretty-ms": "^10.0.0",
		"sequelize": "^6.37.8",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4",
		"sqlite3": "^6.0.1",
		"systeminformation": "^5.33.19",
		"touch": "^3.1.1"
	},
	"optionalDependencies": {
		"bufferutil": "*"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"node-deb": "^0.10.7"
	},
	"overrides": {
		"glob": "^13.0.0",
		"node-gyp": "^12.1.0",
		"validator": "^13.15.23"
	},
	"allowScripts": {
		"bufferutil@4.1.0": true,
		"sqlite3@6.0.1": true,
		"cpu-features": false,
		"msgpackr-extract": false,
		"protobufjs": false,
		"ssh2": false
	}
}
