#!/bin/bash

set -o pipefail

environment_file="/etc/default/virgo-virtual-ip"
unit="virgo-virtual-ip.service"

if [ ! -f "$environment_file" ]; then
	echo "$environment_file is missing; refusing to claim a virtual IP."
	exit 1
fi

. "$environment_file"

if [ -z "$VIRTUAL_IP_ADDR" ] || [ -z "$VIRTUAL_IP_DEV" ]; then
	echo "$environment_file is incomplete; refusing to claim a virtual IP."
	exit 1
fi

if ip -4 -o addr show | grep -Fqw "$VIRTUAL_IP_ADDR"; then
	exit 0
fi

arping -D -q -c 2 -w 3 -I "$VIRTUAL_IP_DEV" "$VIRTUAL_IP_ADDR"
status=$?

if [ "$status" -eq 0 ]; then
	exit 0
fi

if [ "$status" -ne 1 ]; then
	echo "Could not determine whether $VIRTUAL_IP_ADDR is in use; claiming it anyway."
	exit 0
fi

echo "$VIRTUAL_IP_ADDR is already held by another host; not claiming it."
systemctl disable "$unit"
exit 1
